#!/usr/bin/env sh
# Pull every prod source: Grafana's probe logs, the Lambda platform reports, then
# the CloudFront access logs.
#
#   production_logs/pull/all
#
# In order of perishability -- Loki keeps 14 days, CloudWatch and the CloudFront
# buckets 90 -- and each source runs whether or not another failed, so a missing
# GRAFANA_ANALYTICS_TOKEN does not stop the AWS pulls. Exits with the worst
# child's status.
set -u

DIR=$(cd "$(dirname "$0")" && pwd)
status=0

node "$DIR/grafana.ts" || status=$?
node "$DIR/lambda.ts" || status=$?
"$DIR/cloudfront" || status=$?

exit "$status"
