  expect "the error is kept" "error|Runtime.ExitError" \
    "$(q "$w" "SELECT status || '|' || error_type FROM lambda_invocations WHERE function_name = 'Search';")"
  # Init plus work: 300+150 and 280+120.
  expect "cold starts outside the probe" "2|2|100.0|425.0" \
