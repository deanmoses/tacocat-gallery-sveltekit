# --- a failure explains itself; a success saying something new is a finding ---
case_unknown_probe_message() {
  w=$1
  f=$w/$PROBES
  # The failed API execution gains the agent's explanation, in its own words.
  cat >> "$f" <<'LINE'
{"timestamp":"1789207260500000000","line":"target=https://api.pix.tacocat.com/album/ probe=Ohio level=ERROR msg=\"Error making HTTP request\" err=\"context deadline exceeded\"\n","labels":{"job":"Tacocat Album API","probe":"Ohio","probe_success":"0"},"metadata":{"execution_id":"3d2ec3f9-df12-49fa-b807-e4384e182140"}}
LINE
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "no findings"    "0" "$(q "$w" 'SELECT count(*) FROM checks;')"
  expect "reason kept on the execution" "Error making HTTP request" \
    "$(q "$w" "SELECT failure_reason FROM probe_executions WHERE NOT success;")"
  expect "and the line counted" "6" "$(q "$w" "SELECT lines FROM probe_executions WHERE NOT success;")"
  expect "a success has no reason" "true" "$(q "$w" "SELECT failure_reason IS NULL FROM probe_executions WHERE success;")"
  # The successful SPA execution says something the reader has never seen.
  cat >> "$f" <<'LINE'
{"timestamp":"1789207200150000000","line":"target=https://pix.tacocat.com/ probe=Paris level=DEBUG msg=\"Negotiated HTTP/3\"\n","labels":{"job":"Tacocat SPA","probe":"Paris","probe_success":"1"},"metadata":{"execution_id":"5efded10-62d4-4340-888e-45931bd171c8"}}
LINE
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "probe_unknown_message fires" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name = 'probe_unknown_message' AND detail LIKE '%Negotiated HTTP/3%';")"
}

# --- the fields CloudFront can add, and connections told apart by port ---------
# A SPA file as it looks with the API behind the distribution and every optional
# timing field on. One browser loads a page and its album JSON on one port and a
# chunk on another, then comes back to the first port ten minutes later, which
# is a new connection that happens to reuse the number.
case_origin_fields() {
  w=$1
  d=$w/dumps/cloudfront/prod/spa/2026/09/14
  mkdir -p "$d"
  ua='Mozilla/5.0%20(Macintosh;%20Intel%20Mac%20OS%20X%2010_15_7)%20AppleWebKit/605.1.15%20(KHTML,%20like%20Gecko)%20Version/26.0%20Safari/605.1.15'
  cf_line() {  # time, epoch ms, port, path, result type, origin-fbl, origin-lbl, behavior
    printf '2026-09-14\t%s\tSFO53-P10\t1376\t10.0.0.20\tGET\td1e0qhrql1yoqo.cloudfront.net\t%s\t200\t-\t%s\t-\t%s\treq%s\tpix.tacocat.com\thttps\t170\t0.150\tTLSv1.3\tTLS_AES_128_GCM_SHA256\t%s\tHTTP/3.0\t%s\t0.149\t%s\tapplication/json\t-\t7018\tUS\t%s\t%s\t%s\t%s\n' \
      "$1" "$4" "$ua" "$5" "$2" "$5" "$3" "$5" "$2" "$6" "$7" "$8"
  }
  {
    printf '#Version: 1.0\n'
    sed -n 2p "$w/$NEW_SPA" | sed 's/$/ timestamp(ms) origin-fbl origin-lbl cache-behavior-path-pattern/'
    cf_line 09:00:00 1789376400100 50001 / Hit - - '*'
    cf_line 09:00:00 1789376400300 50001 /api/album/2026/09-07/ Miss 0.142 0.145 '/api/*'
    cf_line 09:00:00 1789376400700 50002 /_app/immutable/nodes/3.js Hit - - '/_app/immutable/*'
    cf_line 09:10:00 1789377000050 50001 /api/album/2026/ Miss 0.098 0.101 '/api/*'
  } > "$d/E3DFANBWDVJ2DM.2026-09-14-09.fixture.tsv"
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "no findings"    "0" "$(q "$w" 'SELECT count(*) FROM checks;')"
  expect "milliseconds order a second" "09:00:00.100|09:00:00.300|09:00:00.700|09:10:00.050" \
    "$(q "$w" "SELECT string_agg(strftime(ts, '%H:%M:%S.%g'), '|' ORDER BY ts) FROM cloudfront_requests WHERE client_ip = '10.0.0.20';")"
  expect "origin timings only where the origin was asked" "-/-|0.142/0.145|-/-|0.098/0.101" \
    "$(q "$w" "SELECT string_agg(coalesce(origin_ttfb_seconds::VARCHAR, '-') || '/' || coalesce(origin_seconds::VARCHAR, '-'), '|' ORDER BY ts) FROM cloudfront_requests WHERE client_ip = '10.0.0.20';")"
  expect "the behavior that answered" "*|/api/*|/_app/immutable/*|/api/*" \
    "$(q "$w" "SELECT string_agg(cache_behavior, '|' ORDER BY ts) FROM cloudfront_requests WHERE client_ip = '10.0.0.20';")"
  expect "files without the fields read NULL" "0" \
    "$(q "$w" "SELECT count(*) FROM cloudfront_requests WHERE client_ip <> '10.0.0.20' AND (origin_ttfb_seconds IS NOT NULL OR cache_behavior IS NOT NULL);")"
  expect "connections, and the API sharing one" "50001#1=2/1|50001#2=1/1|50002#1=1/0" \
    "$(q "$w" "SELECT string_agg(client_port || '#' || seq || '=' || requests || '/' || api_requests, '|' ORDER BY client_port, seq) FROM connections WHERE client_ip = '10.0.0.20';")"
}

