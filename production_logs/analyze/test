# --- a report the reader cannot place is named, not quietly dropped ------------
case_unreadable_lambda() {
  w=$1
  f=$w/$LAMBDA
  # Search's stream, three lines of it, loses the stack prefix; r2's record loses its duration; and a
  # plain-text line, as Lambda writes when a function logs outside JSON, appears.
  sed 's/tacocat-gallery-sam-prod-Search\[/Search[/; s/\\"durationMs\\":40.0,//' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  cat >> "$f" <<'LINE'
{"eventId":"1005","timestamp":1789214400020,"logStreamName":"2026/09/12/tacocat-gallery-sam-prod-GetAlbum[$LATEST]aaaa1111","message":"START RequestId: r5 Version: $LATEST"}
LINE
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "lambda_unreadable_stream fires" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name = 'lambda_unreadable_stream' AND detail LIKE '3 events come from streams like %Search[%';")"
  expect "lambda_report_without_duration fires" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name = 'lambda_report_without_duration' AND detail LIKE '%\"requestId\":\"r2\"%';")"
  expect "lambda_unknown_event fires" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name = 'lambda_unknown_event' AND detail LIKE '%START RequestId: r5%';")"
}

# Three resizes, each naming the CloudFront request that caused it. g1 logs its
# request as a string of JSON and g2 as an object, the two shapes CloudWatch has
# held; g3 was asked for an empty size, which the rewrite passes on as a trailing
# slash.
resize_events() {  # $1 = lambda dump file to append to
