# --- reading an album, one image at a time -----------------------------------
# The iPhone at 10.0.0.1 opens the 09-07 album, then image b. b arrives resized by
# g1 with its preloaded neighbours: c from the bucket, a from the edge. Next
# preloads d half a minute later, then e 45 seconds after that. A size the SPA
# does not ask for, resized by g2, and a cropped grid thumbnail come too.
case_album_read() {
  w=$1
  ua='Mozilla/5.0%20(iPhone;%20CPU%20iPhone%20OS%2018_7%20like%20Mac%20OS%20X)%20AppleWebKit/605.1.15%20(KHTML,%20like%20Gecko)%20Version/26.6.1%20Mobile/15E148%20Safari/604.1'
  img_line() {  # time, path, query, result type, time-taken, time-to-first-byte, request id
    printf '2026-09-12\t%s\tSFO53-P10\t140000\t10.0.0.1\tGET\td1e0qhrql1yoqo.cloudfront.net\t%s\t200\thttps://pix.tacocat.com/\t%s\t%s\t%s\t%s\timg.pix.tacocat.com\thttps\t170\t%s\tTLSv1.3\tTLS_AES_128_GCM_SHA256\t%s\tHTTP/3.0\t60057\t%s\t%s\timage/webp\t-\t7018\tUS\n' \
      "$1" "$2" "$ua" "$3" "$4" "$7" "$5" "$4" "$6" "$4"
  }
  {
    img_line 10:00:03 /i/2026/09-07/a.jpg 'version=va&size=200x200&crop=1,2,3,4' Hit 0.012 0.011 img1
    img_line 10:00:05 /i/2026/09-07/b.jpg 'version=vb&size=1024' Miss 2.600 2.590 img2
    img_line 10:00:05 /i/2026/09-07/c.jpg 'version=vc&size=x1024' Miss 0.300 0.290 img3
    img_line 10:00:05 /i/2026/09-07/a.jpg 'version=va&size=1024' Hit 0.010 0.009 img4
    img_line 10:00:35 /i/2026/09-07/d.jpg 'version=vd&size=1024' Miss 0.280 0.270 img5
    img_line 10:01:20 /i/2026/09-07/e.jpg 'version=ve&size=1024' Hit 0.012 0.011 img6
    img_line 10:02:00 /i/2026/09-07/a.jpg 'version=va&size=613' Miss 1.200 1.190 img7
    img_line 10:03:00 /i/2026/09-07/a.jpg 'version=va&size=' Miss 1.100 1.090 img8
  } >> "$w/$NEW_IMAGE"
  resize_events "$w/$LAMBDA"
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "no findings"    "0" "$(q "$w" 'SELECT count(*) FROM checks;')"
  expect "kinds" "detail=5|other=2|thumbnail=1" \
    "$(q "$w" "SELECT string_agg(kind || '=' || n, '|' ORDER BY kind) FROM (SELECT kind, count(*) AS n FROM image_requests WHERE client_ip = '10.0.0.1' GROUP BY 1);")"
  expect "parsed from the URL" "/2026/09-07|/2026/09-07/a.jpg|va|200x200|1,2,3,4" \
    "$(q "$w" "SELECT album_path || '|' || media_path || '|' || version || '|' || size || '|' || crop FROM image_requests WHERE request_id = 'img1';")"
  expect "served by" "img1=edge|img2=resized|img3=bucket|img4=edge|img5=bucket|img6=edge|img7=resized|img8=resized" \
    "$(q "$w" "SELECT string_agg(request_id || '=' || served_by, '|' ORDER BY request_id) FROM image_requests WHERE client_ip = '10.0.0.1';")"
  expect "the resize behind a miss" "g1|true|600.0" \
    "$(q "$w" "SELECT resize_request_id || '|' || resize_cold || '|' || resize_init_ms FROM image_requests WHERE request_id = 'img2';")"
  expect "a request logged as an object" "/i/2026/09-07/a.jpg/va/613" \
    "$(q "$w" "SELECT path FROM lambda_invocations WHERE request_id = 'g2';")"
  # Detail requests at :05, :05, :05, :35 and 1:20 are gaps of 0, 0, 30 and 45.
  expect "the read" "5|5|2|2|1|15.0|1|true" \
    "$(q "$w" "SELECT images || '|' || requests || '|' || from_edge || '|' || from_bucket || '|' || resized || '|' || median_gap_s || '|' || thumbnails || '|' || is_visit FROM album_reads WHERE client_ip = '10.0.0.1';")"
  expect "delivery from the bucket" "2|2|280.0" \
    "$(q "$w" "SELECT requests || '|' || visit_requests || '|' || median_ttfb_ms FROM image_delivery WHERE kind = 'detail' AND served_by = 'bucket';")"
}

# --- a resize that stops naming its CloudFront request is a finding -----------
case_resize_without_cf_id() {
  w=$1
  resize_events "$w/$LAMBDA"
  # A later resize whose request line carries no id.
  cat >> "$w/$LAMBDA" <<'LINE'
{"eventId":"2007","timestamp":1789207439000,"logStreamName":"2026/09/12/tacocat-gallery-sam-prod-GenerateDerivedImage[$LATEST]eeee5555","message":"{\"timestamp\":\"2026-09-12T10:03:59.000Z\",\"level\":\"INFO\",\"requestId\":\"g4\",\"message\":{\"event\":\"request_received\",\"method\":\"GET\",\"path\":\"/i/2026/09-07/c.jpg/vc/1024\"}}"}
LINE
  expect "build succeeds" "0" "$(build "$w" && echo 0 || echo 1)"
  expect "lambda_resize_without_cf_id fires" "1" \
    "$(q "$w" "SELECT count(*) FROM checks WHERE check_name = 'lambda_resize_without_cf_id' AND detail LIKE '1 derived-image requests %/i/2026/09-07/c.jpg/vc/1024';")"
}

for c in baseline unknown_field missing_field malformed_line unknown_distribution no_dumps no_grafana unknown_probe_message \
         origin_fields no_lambda unreadable_lambda album_read resize_without_cf_id; do
  name=$(echo "$c" | tr '_' '-')
  skip_case "$name" && continue
  printf '  %s\n' "$name"
  w=$(mktemp -d)
  setup "$w"
  "case_$c" "$w"
  rm -rf "$w"
done

