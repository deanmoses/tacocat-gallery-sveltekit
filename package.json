{
    "name": "tacocat-gallery-sveltekit",
    "version": "0.0.10",
    "private": true,
    "description": "Javascript front end for the tacocat.com photo gallery, built with Sveltekit",
    "keywords": [
        "javascript",
        "typescript",
        "svelte",
        "sveltekit"
    ],
    "license": "MIT",
    "author": "Dean Moses",
    "repository": {
        "type": "git",
        "url": "git://github.com/deanmoses/tacocat-gallery-sveltekit"
    },
    "scripts": {
        "dev": "vite dev",
        "build-debug": "vite build --mode development --sourcemap true --minify false",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run --silent",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:all": "npm run test && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:e2e:staging": "BASE_URL=https://staging-pix.tacocat.com playwright test",
        "test:e2e:prod": "BASE_URL=https://pix.tacocat.com playwright test",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "svelte-kit sync && prettier --check . && eslint . --max-warnings 0 --concurrency auto && markdownlint-cli2 && stylelint \"src/**/*.{css,svelte}\" && knip --no-progress",
        "lint:shell": "shellcheck scripts/*.sh .claude/hooks/*.sh .husky/pre-commit",
        "lint:actions": "actionlint",
        "format": "prettier --write --log-level warn .",
        "quality": "npm run format && npm run lint && npm run check",
        "precommit": "npm run quality && npm run test:unit",
        "deploy-staging": "./scripts/deploy-staging.sh",
        "deploy-prod": "./scripts/deploy-prod.sh",
        "perf": "node scripts/measure-perf.mjs",
        "agent-docs": "node scripts/build-agent-docs.mjs",
        "prepare": "husky && playwright install chromium && svelte-kit sync"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.63.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/node": "^24.13.3",
        "@vitest/browser-playwright": "^5.0.0",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "@zerodevx/svelte-toast": "^0.9.6",
        "eslint": "^10.10.0",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-svelte": "^3.23.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "knip": "^6.35.1",
        "lint-staged": "^17.5.0",
        "markdownlint-cli2": "^0.23.2",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "stylelint": "^17.15.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0",
        "vitest-browser-svelte": "^3.1.0"
    },
    "dependencies": {
        "idb-keyval": "^6.3.0",
        "immer": "^11.1.18",
        "quill": "^2.0.3",
        "svelte-easy-crop": "^5.0.1"
    },
    "engineStrict": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "type": "module",
    "lint-staged": {
        "*.{js,mjs,ts}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.svelte": [
            "prettier --write",
            "eslint --fix",
            "stylelint --fix"
        ],
        "*.css": [
            "prettier --write",
            "stylelint --fix"
        ],
        "*.{json,jsonc,html,yml,yaml}": "prettier --write",
        "*.md": [
            "prettier --write",
            "markdownlint-cli2 --fix"
        ]
    }
}
