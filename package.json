{
    "name": "tacocat-gallery-sveltekit",
    "version": "0.0.10",
    "private": true,
    "description": "Javascript front end for the tacocat.com photo gallery, built with Sveltekit",
    "keywords": [
        "javascript",
        "typescript",
        "svelte",
        "sveltekit"
    ],
    "license": "MIT",
    "author": "Dean Moses",
    "repository": {
        "type": "git",
        "url": "git://github.com/deanmoses/tacocat-gallery-sveltekit"
    },
    "scripts": {
        "dev": "vite dev",
        "build-debug": "vite build --mode development --sourcemap true --minify false",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run --silent",
        "test:unit": "vitest run",
        "test:all": "npm run test && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:e2e:staging": "BASE_URL=https://staging-pix.tacocat.com playwright test",
        "test:e2e:prod": "BASE_URL=https://pix.tacocat.com playwright test",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write --log-level warn .",
        "quality": "npm run format && npm run lint && npm run check",
        "precommit": "npm run quality && npm run test:unit",
        "deploy-staging": "./deploy_staging.sh",
        "deploy-prod": "./deploy_prod.sh",
        "agent-docs": "node scripts/build-agent-docs.mjs",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.63.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@types/node": "^24.13.3",
        "@zerodevx/svelte-toast": "^0.9.6",
        "eslint": "^10.10.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "svelte-eslint-parser": "^1.8.1",
        "svelte-preprocess": "^6.0.5",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "idb-keyval": "^6.3.0",
        "immer": "^11.1.18",
        "quill": "^2.0.3",
        "svelte-easy-crop": "^5.0.1"
    },
    "engineStrict": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "type": "module",
    "lint-staged": {
        "*.{js,mjs,ts,svelte}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,css,html,md,yml,yaml}": "prettier --write"
    }
}
